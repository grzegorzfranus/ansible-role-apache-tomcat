{{ ansible_managed | comment('#') }}
module tomcat_systemd 1.1;

require {
    type init_t;
    type var_log_t;
    type usr_t;
    class dir { add_name write search getattr open read };
    class file { create write open append read execute execute_no_trans getattr setattr map ioctl };
    class lnk_file { read getattr };
}

# --- Log directory (var_log_t) ---
# Allow systemd (init_t) to create and append to files in var_log_t directories.
# Required when StandardOutput=append:{{ tomcat_log_dir }}/catalina.out is used.
allow init_t var_log_t:dir { add_name write search };
allow init_t var_log_t:file { create write open append getattr setattr };

# --- Tomcat install directory (usr_t) ---
# /opt/tomcat/ and its contents inherit usr_t from /opt(/.*)?
# Allow systemd (init_t) to:
#   1. Read the symlink {{ tomcat_symlink_path }} -> {{ tomcat_catalina_home }}
#   2. Search directories under {{ tomcat_install_dir }}
#   3. Execute {{ tomcat_symlink_path }}/bin/catalina.sh (ExecStart/ExecStop)
allow init_t usr_t:lnk_file { read getattr };
allow init_t usr_t:dir { search getattr open read };
allow init_t usr_t:file { read execute execute_no_trans open getattr map ioctl };
