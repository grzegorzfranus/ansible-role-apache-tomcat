#jinja2: trim_blocks: True, lstrip_blocks: True
<?xml version="1.0" encoding="UTF-8"?>
<!--
  {{ ansible_managed }}

  =============================================================================
  Apache Tomcat {{ tomcat_version }} - Server Configuration
  =============================================================================
  Enterprise Split Tomcat architecture (CATALINA_HOME / CATALINA_BASE)
  Generated by Ansible - DO NOT EDIT MANUALLY
  =============================================================================
-->
<Server port="{{ tomcat_shutdown_port }}" shutdown="SHUTDOWN">

  <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

  <GlobalNamingResources>
    <Resource name="UserDatabase"
              auth="Container"
              type="org.apache.catalina.UserDatabase"
              description="User database for authentication"
              factory="org.apache.catalina.users.MemoryUserDatabaseFactory"
              pathname="conf/tomcat-users.xml" />
  </GlobalNamingResources>

  <Service name="Catalina">

    {% if tomcat_enable_ssl | bool %}
    <!-- HTTPS Connector (PKCS12 Keystore) -->
    <Connector port="{{ tomcat_https_port }}"
               address="{{ tomcat_https_address }}"
               protocol="org.apache.coyote.http11.Http11NioProtocol"
               maxThreads="{{ tomcat_connector_max_threads }}"
               connectionTimeout="{{ tomcat_connector_connection_timeout }}"
               enableLookups="{{ tomcat_connector_enable_lookups | string | lower }}"
               URIEncoding="{{ tomcat_connector_uri_encoding }}"
               SSLEnabled="true"
               scheme="https"
               secure="true"
               server="{{ tomcat_server_header }}"
               keystoreFile="{{ tomcat_ssl_keystore_file }}"
               keystorePass="{{ tomcat_ssl_keystore_password }}"
               keystoreType="{{ tomcat_ssl_keystore_type }}"
               keyAlias="{{ tomcat_ssl_key_alias }}"
               sslProtocol="{{ tomcat_ssl_protocol }}"
               sslEnabledProtocols="{{ tomcat_ssl_enabled_protocols }}"
               ciphers="{{ tomcat_ssl_ciphers }}"
               clientAuth="false"
               {% if tomcat_enable_hardening | bool %}
               allowTrace="false"
               xpoweredBy="false"
               {% endif %}
               />

    {% endif %}
    {% if tomcat_enable_http | bool %}
    <!-- HTTP Connector -->
    <Connector port="{{ tomcat_http_port }}"
               address="{{ tomcat_http_address }}"
               protocol="HTTP/1.1"
               maxThreads="{{ tomcat_connector_max_threads }}"
               connectionTimeout="{{ tomcat_connector_connection_timeout }}"
               enableLookups="{{ tomcat_connector_enable_lookups | string | lower }}"
               URIEncoding="{{ tomcat_connector_uri_encoding }}"
               server="{{ tomcat_server_header }}"
               {% if tomcat_enable_ssl | bool %}
               redirectPort="{{ tomcat_https_port }}"
               {% endif %}
               {% if tomcat_enable_hardening | bool %}
               allowTrace="false"
               xpoweredBy="false"
               {% endif %}
               />

    {% endif %}
    {% if tomcat_enable_ajp | bool %}
    <!-- AJP Connector -->
    <Connector port="{{ tomcat_ajp_port }}"
               protocol="AJP/1.3"
               {% if tomcat_enable_ssl | bool %}
               redirectPort="{{ tomcat_https_port }}"
               {% endif %}
               secretRequired="{{ tomcat_ajp_secret_required | string | lower }}"
               {% if tomcat_ajp_secret_required | bool and tomcat_ajp_secret | default('') | length > 0 %}
               secret="{{ tomcat_ajp_secret }}"
               {% endif %}
               address="{{ tomcat_ajp_address }}" />

    {% endif %}
    <Engine name="Catalina" defaultHost="localhost">

      <Realm className="org.apache.catalina.realm.LockOutRealm"
             failureCount="{{ tomcat_lockout_failure_count }}"
             lockOutTime="{{ tomcat_lockout_time }}">
        <Realm className="org.apache.catalina.realm.UserDatabaseRealm"
               resourceName="UserDatabase" />
      </Realm>

      <Host name="localhost"
            appBase="webapps"
            unpackWARs="{{ tomcat_unpack_wars | string | lower }}"
            autoDeploy="{{ tomcat_auto_deploy | string | lower }}"
            deployOnStartup="{{ tomcat_deploy_on_startup | string | lower }}">

        {% if tomcat_behind_proxy | bool %}
        <!-- Reverse Proxy: trust X-Forwarded-* headers from internal proxies -->
        <Valve className="org.apache.catalina.valves.RemoteIpValve"
               remoteIpHeader="{{ tomcat_proxy_remote_ip_header }}"
               protocolHeader="{{ tomcat_proxy_protocol_header }}"
               protocolHeaderHttpsValue="https"
               internalProxies="{{ tomcat_proxy_internal_proxies }}" />

        {% endif %}
        <Valve className="org.apache.catalina.valves.AccessLogValve"
               directory="{{ tomcat_log_dir }}"
               prefix="access"
               suffix=".log"
               {% if tomcat_behind_proxy | bool and tomcat_proxy_log_proxy_ip | bool %}
               pattern="%{org.apache.tomcat.remoteAddr}r %l %u %t &quot;%r&quot; %s %b %D - %h"
               {% else %}
               pattern="%h %l %u %t &quot;%r&quot; %s %b %D"
               {% endif %}
               rotatable="false"
               checkExists="true"
               {% if tomcat_behind_proxy | bool and not tomcat_proxy_log_proxy_ip | bool %}
               requestAttributesEnabled="true"
               {% endif %}
               />

        {% if tomcat_enable_hardening | bool %}
        <!-- Hide Tomcat version and stack traces on error pages -->
        <Valve className="org.apache.catalina.valves.ErrorReportValve"
               showServerInfo="false"
               showReport="false" />
        {% endif %}

        {% set __rewrite_needed = (tomcat_enable_hardening | bool) or (tomcat_enable_ssl | bool and tomcat_force_https | default(true) | bool and tomcat_enable_http | bool) %}
        {% if __rewrite_needed %}
        <!-- RewriteValve: method blocking (hardening) and/or force HTTPS redirect -->
        <Valve className="org.apache.catalina.valves.rewrite.RewriteValve" />
        {% endif %}

      </Host>
    </Engine>
  </Service>
</Server>
