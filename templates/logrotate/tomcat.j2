#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}

# =============================================================================
# Apache Tomcat - Logrotate Configuration
# =============================================================================
# All Tomcat logs use fixed names (no date suffixes). Logrotate is the single
# rotation mechanism — JULI and AccessLogValve have rotatable=false.
# Rotated files are compressed and moved to the archive directory.
# =============================================================================

# --- Catalina console output (systemd stdout/stderr) ---
{{ tomcat_log_dir }}/catalina.out {
    su {{ tomcat_user }} {{ tomcat_group }}
    {{ tomcat_logrotate_options.frequency }}
    rotate {{ tomcat_logrotate_options.count }}
    {% if tomcat_logrotate_options.missingok %}
    missingok
    {% endif %}
    {% if tomcat_logrotate_options.compress %}
    compress
    {% endif %}
    copytruncate
    {% if tomcat_logrotate_options.dateext %}
    dateext
    dateformat .%Y-%m-%d
    {% endif %}
    {% if tomcat_logrotate_options.archive_directory_path is defined and tomcat_logrotate_options.archive_directory_path | length > 0 %}
    olddir {{ tomcat_logrotate_options.archive_directory_path }}
    {% endif %}
}

