#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}

# =============================================================================
# Apache Tomcat - Logrotate Configuration
# =============================================================================
# All Tomcat logs use fixed names (no date suffixes). Logrotate is the single
# rotation mechanism — JULI and AccessLogValve have rotatable=false.
# Rotated files are compressed and moved to the archive directory.
# =============================================================================

{% set __tomcat_log_files = [
    'catalina.out',
    'catalina.log',
    'localhost.log',
    'access.log'
] + (['gc.log'] if tomcat_enable_gc_logging | bool else []) %}
{% for log_file in __tomcat_log_files %}
# Logrotate configuration for {{ log_file }}
{{ tomcat_log_dir }}/{{ log_file }} {
    {% if tomcat_logrotate_options.su | default(true) | bool %}
    su {{ tomcat_user }} {{ tomcat_group }}
    {% endif %}
    {{ tomcat_logrotate_options.frequency }}
    rotate {{ tomcat_logrotate_options.count }}
    {% if tomcat_logrotate_options.missingok | bool %}
    missingok
    {% endif %}
    {% if tomcat_logrotate_options.compress | bool %}
    compress
    {% endif %}
    {% if tomcat_logrotate_options.copytruncate | default(true) | bool %}
    copytruncate
    {% elif tomcat_logrotate_options.nocreate | default(true) | bool %}
    nocreate
    {% endif %}
    {% if tomcat_logrotate_options.dateext | bool %}
    dateext
    {% if tomcat_logrotate_options.frequency == 'hourly' %}
    dateformat .%Y-%m-%d-%H
    {% else %}
    dateformat .%Y-%m-%d
    {% endif %}
    {% endif %}
    {% if tomcat_logrotate_options.archive_directory_path is defined and tomcat_logrotate_options.archive_directory_path | length > 0 %}
    olddir {{ tomcat_logrotate_options.archive_directory_path }}
    {% endif %}
}
{% if not loop.last %}

{% endif %}
{% endfor %}
